# Copy to backend/.env and fill in. NEVER commit the real .env.
# Keys are read only by the Python backend; the browser never sees them.

# --- Market data (Alpaca) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" = free Basic plan (IEX exchange only), "sip" = Algo Trader Plus (full consolidated tape)
ALPACA_STOCK_FEED=iex

# --- Optional fallback / news (Finnhub free tier) ---
FINNHUB_API_KEY=

# --- App ---
DATABASE_URL=sqlite:///./data/iren.db
PRIMARY_SYMBOL=IREN
CONTEXT_SYMBOLS=CRWV,NBIS,NVDA,QQQ
CRYPTO_SYMBOLS=BTC/USD
