# Copy to backend/.env (or the repo root .env) and fill in. NEVER commit the real .env.
# Keys are read only by the Python backend; the browser never sees them.

# --- Market data (Alpaca) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" = free Basic plan (IEX exchange only), "sip" = Algo Trader Plus ($99/mo, full consolidated tape)
ALPACA_STOCK_FEED=iex
# Feed for the history backfill. Empty = same as ALPACA_STOCK_FEED (keeps volume features consistent)
ALPACA_HISTORY_FEED=

# --- Optional fallback / news (Finnhub free tier) ---
FINNHUB_API_KEY=

# --- App ---
# auto = Alpaca if keys are set, otherwise simulated demo data (stored in a separate *-demo.db)
DATA_SOURCE=auto
# Default: sqlite file in ./data/. For Postgres: postgresql+psycopg://user:pass@host:5432/iren
DATABASE_URL=
PRIMARY_SYMBOL=IREN
CONTEXT_SYMBOLS=CIFR,NBIS,CRWV,NVDA,QQQ
CRYPTO_SYMBOLS=BTC/USD
POLL_INTERVAL_S=10
HISTORY_YEARS=2
CORS_ORIGINS=http://localhost:3000
